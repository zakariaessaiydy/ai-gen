  "beats": [
    {
      "id": "why",
      "start": 0,
      "visual": "Why do we have summer, fall, winter, and spring?",
      "end": 5.17
    },
    {
      "id": "guess",
      "start": 5.17,
      "visual": "I know! In summer, the Sun comes closer. In winter, it goes far away!",
      "end": 10.86
    },
    {
      "id": "good",
      "start": 10.86,
      "visual": "Good guess, Leo! Let's find out.",
      "end": 14.85
    },
    {
      "id": "around",
      "start": 14.85,
      "visual": "Our Earth travels all the way around the Sun. One trip takes a whole year!",
      "end": 21.34
    },
    {
      "id": "tilt",
      "start": 21.34,
      "visual": "And look! The Earth is tilted. It leans, like this.",
      "end": 27.14
    },
    {
      "id": "say",
      "start": 27.14,
      "visual": "Can you say it? Tilt!",
      "end": 31.77
    },
    {
      "id": "leo_say",
      "start": 31.77,
      "visual": "Tilt!",
      "end": 34.42
    },
    {
      "id": "lean_in",
      "start": 34.42,
      "visual": "When our side leans toward the Sun, the sunshine is strong, and the days are long. It's summer!",
      "end": 41.72
    },
    {
      "id": "lean_out",
      "start": 41.72,
      "visual": "When our side leans away, the sunshine is weak, and the days are short. Brrr! It's winter!",
      "end": 48.96
    },
    {
      "id": "between",
      "start": 48.96,
      "visual": "And in between, we have fall, and spring!",
      "end": 53.77
    },
    {
      "id": "lean_turn",
      "start": 53.77,
      "visual": "Can you lean like the Earth? Lean, lean, lean!",
      "end": 59.15
    },
    {
      "id": "torch",
      "start": 59.15,
      "visual": "Try it with a grown-up! Shine a flashlight straight down. Then tilt it.",
      "end": 66.97
    },
    {
      "id": "see",
      "start": 66.97,
      "visual": "Straight down makes a small, bright spot. Tilted makes a big, weak spot!",
      "end": 73.64
    },
    {
      "id": "leo_wow",
      "start": 73.64,
      "visual": "So it's not about close or far. It's the tilt!",
      "end": 78.5
    },
    {
      "id": "other",
      "start": 78.5,
      "visual": "And when it's summer on our side of the world, it's winter on the other side!",
      "end": 85.66
    },
    {
      "id": "recap",
      "start": 85.66,
      "visual": "Let's remember!",
      "end": 87.93
    },
    {
      "id": "r1",
      "start": 87.93,
      "visual": "Earth goes around the Sun.",
      "end": 91.61
    },
    {
      "id": "r2",
      "start": 91.61,
      "visual": "Earth is tilted.",
      "end": 95.05
    },
    {
      "id": "r3",
      "start": 95.05,
      "visual": "Lean in is summer. Lean away is winter!",
      "end": 99.92
