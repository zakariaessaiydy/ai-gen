# Copy to .env (never commit .env). Every key is optional — set only the services you use.

# ElevenLabs — voice (default gen_voice engine), SFX (gen_sfx.py) and music beds (gen_music.py)
ELEVENLABS_API_KEY=

# fal.ai — generative video clips (gen_clip.py, bakeoff_clip.py)
FAL_KEY=

# Google Gemini — AI images / collage layers (gen_image.py)
GEMINI_API_KEY=

# Azure Speech FREE tier — real child voices for the kids channel (gen_voice --engine azure,
# or "engine": "azure" on a cast entry)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: a different calendar workbook for tools/next_video.py
# CALENDAR_XLSX=TINY-SPARKS-CALENDAR.xlsx

# No key needed: --engine kokoro (free, local; python tools/setup_kokoro.py once)
#                --engine edge   (free Edge Neural TTS; online)
