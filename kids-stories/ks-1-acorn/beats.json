  },
  "vo": [
    {
      "beat": "hook",
      "text": "Oh no! Where is that acorn going?",
      "start": 0.2,
      "end": 3.2
    },
    {
      "beat": "setup",
      "text": "Come back, little acorn! Wait for me!",
      "start": 3.6,
      "end": 7.1,
      "speaker": "sammy"
    },
    {
      "beat": "setup",
      "text": "This is Sammy the turtle. Sammy loves acorns.",
      "start": 7.5,
      "end": 11.1
    },
    {
      "beat": "setup",
      "text": "This morning he found the biggest, roundest acorn in the whole meadow.",
      "start": 11.5,
      "end": 17.1
    },
    {
      "beat": "setup",
      "text": "I will plant it, and it will grow into a tree!",
      "start": 17.5,
      "end": 22.6,
      "speaker": "sammy"
    },
    {
      "beat": "problem",
      "text": "But the meadow is on a hill. And acorns love to roll.",
      "start": 23.0,
      "end": 28.6
    },
    {
      "beat": "problem",
      "text": "Bump! Roll, roll, roll. Down the hill it goes!",
      "start": 29.0,
      "end": 33.6
    },
    {
      "beat": "problem",
      "text": "Oh no! My acorn!",
      "start": 34.0,
      "end": 36.6,
      "speaker": "sammy"
    },
    {
      "beat": "problem",
      "text": "Sammy walks after it. Step... step... step.",
      "start": 37.0,
      "end": 41.1
    },
    {
      "beat": "problem",
      "text": "But turtles are slow, and the acorn is fast.",
      "start": 41.5,
      "end": 45.6
    },
    {
      "beat": "problem",
      "text": "It rolls past the flowers. It rolls past the big tree.",
      "start": 46.0,
      "end": 51.1
    },
    {
      "beat": "problem",
      "text": "And it rolls all the way into the deep, dark forest.",
      "start": 51.5,
      "end": 56.6
    },
    {
      "beat": "try",
      "text": "Hello? Acorn? Where are you?",
      "start": 57.0,
      "end": 60.6,
      "speaker": "sammy"
    },
    {
      "beat": "try",
      "text": "The forest is big. The trees are tall. Sammy cannot see far.",
      "start": 61.0,
      "end": 66.6
    },
    {
      "beat": "try",
      "text": "I will look under this bush... No acorn.",
      "start": 67.0,
      "end": 71.1,
      "speaker": "sammy"
    },
    {
      "beat": "try",
      "text": "I will look behind this tree... No acorn!",
      "start": 71.5,
      "end": 75.6,
      "speaker": "sammy"
    },
    {
      "beat": "try",
      "text": "Sammy feels sad. He sits down on the soft grass.",
      "start": 76.0,
      "end": 80.6
    },
    {
      "beat": "try",
      "text": "I looked and looked. I cannot find it all by myself.",
      "start": 81.0,
      "end": 86.6,
      "speaker": "sammy"
    },
    {
      "beat": "help",
      "text": "Hoo-hoo! Hello, Sammy! Why are you sad?",
      "start": 87.0,
      "end": 90.6,
      "speaker": "oliver"
    },
    {
      "beat": "help",
      "text": "It's Oliver the owl! Oliver can fly up high and see everything.",
      "start": 91.0,
      "end": 96.6
    },
    {
      "beat": "help",
      "text": "Oliver, I lost my acorn. Can you help me find it?",
      "start": 97.0,
      "end": 101.6,
      "speaker": "sammy"
    },
    {
      "beat": "help",
      "text": "Of course! Friends help friends. Let me fly up and look!",
      "start": 102.0,
      "end": 107.1,
      "speaker": "oliver"
    },
    {
      "beat": "help",
      "text": "Up, up, up flies Oliver. Can you see the acorn too?",
      "start": 107.5,
      "end": 112.6
    },
    {
      "beat": "success",
      "text": "I see it! It is by the pond! Follow me, Sammy!",
      "start": 113.0,
      "end": 118.1,
      "speaker": "oliver"
    },
    {
      "beat": "success",
      "text": "There it is, next to the pond! Sammy found his acorn!",
      "start": 118.5,
      "end": 123.6
    },
    {
      "beat": "success",
      "text": "Thank you, Oliver! You are the best friend!",
      "start": 124.0,
      "end": 127.6,
      "speaker": "sammy"
    },
    {
      "beat": "lesson",
      "text": "Together, they dig a little hole and plant the acorn.",
      "start": 128.0,
      "end": 132.6
    },
    {
      "beat": "lesson",
      "text": "When we work together, big things get easy!",
      "start": 133.0,
      "end": 137.1,
      "speaker": "sammy"
    },
    {
      "beat": "lesson",
      "text": "That's right. When we work together, big things get easy.",
      "start": 137.5,
      "end": 141.6
    },
    {
      "beat": "next",
      "text": "Next time, Oliver learns to count the stars! One, two, three...",
      "start": 142.0,
      "end": 149.6
    }
  ],
