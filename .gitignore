# secrets
.env

# dependencies / build output
node_modules/
remotion/out/
__pycache__/
*.pyc
venv/

# heavy regenerable per-short artifacts:
# voice/ = cached ElevenLabs TTS lines, output/ = rendered videos.
# Both are rebuilt by the pipeline; finals are linked from the README instead.
shorts/*/voice/
shorts/*/output/
ai-shorts/*/voice/
ai-shorts/*/output/
vox-shorts/*/voice/
vox-shorts/*/output/
toon-shorts/*/*/voice/
toon-shorts/*/*/output/

# ai-shorts working copies of generated clips — the canonical (committed) copies
# live in media/projects/<name>/ where the composition reads them via staticFile()
ai-shorts/*/shots/*.mp4
ai-shorts/*/bakeoff/*.mp4

# free local TTS model + voices (tools/setup_kokoro.py re-downloads them)
tools/kokoro/

# local editor config
.vscode/

# kids channel (regenerable: voices, renders, song stems)
kids-shorts/*/*/*/voice/
kids-shorts/*/*/*/output/
kids-shorts/*/songs/*/voice/
kids-shorts/*/songs/*/*.wav

# local caches of generated audio (tools/gen_kids_sounds.py)
tools/.cache/

# kids thumbnails: background frames extracted from the renders (tools/kids_thumbs.py regenerates them)
media/projects/kids-thumbs/frames/
kids-shorts/tiny-sparks/lab/thumbs-out/
kids-shorts/tiny-sparks/lab/shorts-out/

# kids backgrounds: the raw generated PNGs (the committed copy is the fitted jpg; prompt sidecars stay)
media/library/backgrounds/_raw/*.png
